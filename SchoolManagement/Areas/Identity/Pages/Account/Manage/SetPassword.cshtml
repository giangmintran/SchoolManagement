@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Thiết lập mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8 col-xl-6">
        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
                    <p class="text-muted">
                        Bạn chưa có tài khoản cục bộ (local) cho trang web này.
                        <br class="d-none d-md-block" />
                        Hãy thêm tài khoản để có thể đăng nhập trực tiếp mà không cần qua dịch vụ bên ngoài.
                    </p>
                </div>

                <partial name="_StatusMessage" for="StatusMessage" />

                <form id="set-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Nhập mật khẩu mới" />
                        <label asp-for="Input.NewPassword" class="form-label text-secondary">Mật khẩu mới</label>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                        <label asp-for="Input.ConfirmPassword" class="form-label text-secondary">Nhập lại mật khẩu</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg py-3 fw-semibold shadow-sm">
                            Đặt mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}