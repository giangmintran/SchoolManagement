@model SchoolManagement.Data.Entities.ProfessionalActivity

@{
    ViewData["Title"] = "Thêm mới Sinh hoạt chuyên môn";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold text-primary mb-0">
                        <i class="bi bi-journal-plus me-2"></i>Thêm mới Sinh hoạt chuyên môn
                    </h3>
                    <p class="text-muted small mb-0">Điền thông tin chi tiết vào biểu mẫu bên dưới</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> 
                </a>
            </div>

            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">
                            <div class="col-lg-4 col-md-5 border-end-lg">
                                <div class="bg-light p-3 rounded-3 mb-3">
                                    <h6 class="fw-bold text-uppercase text-muted small mb-3">Thông tin chung</h6>

                                    <div class="form-floating mb-3">
                                        <input asp-for="SequenceNumber" class="form-control fw-bold" type="number" min="1" placeholder="Số thứ tự" />
                                        <label asp-for="SequenceNumber"><i class="bi bi-sort-numeric-down me-1"></i> Số thứ tự</label>
                                        <span asp-validation-for="SequenceNumber" class="text-danger small"></span>
                                    </div>

                                    <div class="form-floating mb-3">
                                        <input asp-for="Date" class="form-control" type="date" placeholder="Ngày tháng" />
                                        <label asp-for="Date"><i class="bi bi-calendar-event me-1"></i> Thời gian</label>
                                        <span asp-validation-for="Date" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="Implementation" class="form-label fw-bold">
                                        <i class="bi bi-gear-wide-connected me-1 text-primary"></i> Thực hiện chương trình (Chỉ ghi những lớp chậm, nhanh, cùng biện pháp giải quyết)
                                    </label>
                                    <textarea asp-for="Implementation" class="form-control shadow-sm" rows="3"></textarea>
                                    <span asp-validation-for="Implementation" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-8 col-md-7">
                                <h6 class="fw-bold text-uppercase text-muted small mb-3">Nội dung chi tiết</h6>

                                <div class="form-group mb-4">
                                    <label asp-for="Implementation" class="form-label fw-bold">
                                        <i class="bi bi-gear-wide-connected me-1 text-primary"></i> Quá trình thực hiện
                                    </label>
                                    <textarea asp-for="Implementation" class="form-control shadow-sm" rows="3"></textarea>
                                    <span asp-validation-for="Implementation" class="text-danger small"></span>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="Content" class="form-label fw-bold">
                                        <i class="bi bi-file-text me-1 text-primary"></i> Nội dung sinh hoạt
                                    </label>
                                    <textarea asp-for="Content" class="form-control shadow-sm" rows="10"></textarea>
                                    <span asp-validation-for="Content" class="text-danger small"></span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Proposal" class="form-label fw-bold">
                                                <i class="bi bi-lightbulb me-1 text-warning"></i> Đề xuất / Kiến nghị
                                            </label>
                                            <textarea asp-for="Proposal" class="form-control shadow-sm" rows="4"></textarea>
                                            <span asp-validation-for="Proposal" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Result" class="form-label fw-bold">
                                                <i class="bi bi-check-circle me-1 text-success"></i> Kết quả
                                            </label>
                                            <textarea asp-for="Result" class="form-control shadow-sm" rows="4"></textarea>
                                            <span asp-validation-for="Result" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted">

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light border">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Lưu lại
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom CSS nhỏ để tạo cảm giác focus tốt hơn */
    .form-control:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }

    textarea {
        resize: vertical; /* Chỉ cho phép kéo giãn chiều dọc để không vỡ layout */
    }
    /* Đường kẻ ngăn cách giữa 2 cột chỉ hiện trên màn hình to */
    @@media (min-width: 992px) {
        .border-end-lg {
            border-right: 1px solid #dee2e6;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}