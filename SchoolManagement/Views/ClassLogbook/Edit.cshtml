@using SchoolManagement.Models.ViewModels
@model SchoolManagement.Models.LogbookUpsertViewModel

@{
    ViewData["Title"] = "Cập nhật Sổ Đầu Bài";

    // Cấu hình Header
    var pageHeader = new PageHeaderViewModel
    {
        Title = $"Cập nhật Sổ đầu bài - Lớp {Model.ClassName}",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem { Title = "Danh sách", Url = Url.Action("Index") ?? string.Empty },
            new BreadcrumbItem { Title = "Chỉnh sửa", IsActive = true }
        }
    };
}

@* --- 1. THÊM CSS ĐỂ XỬ LÝ GIAO DIỆN MOBILE (GIỮ NGUYÊN) --- *@
<style>
    /* Áp dụng cho màn hình nhỏ hơn 768px (Mobile) */
    @@media (max-width: 767.98px) {
        /* Vô hiệu hóa tương tác chuột/bàn phím vào input/select */
        .mobile-readonly input,
        .mobile-readonly select,
        .mobile-readonly textarea {
            pointer-events: none !important; /* Không cho click */
            background-color: transparent !important; /* Nền trong suốt */
            border: none !important; /* Bỏ viền */
            box-shadow: none !important; /* Bỏ bóng */
            color: #212529 !important; /* Màu chữ đen */
            resize: none; /* Không cho kéo giãn textarea */
            -webkit-appearance: none; /* Ẩn style mặc định của browser */
            -moz-appearance: none;
            padding-left: 0;
            padding-right: 0;
        }
        /* Ẩn placeholder trên mobile cho đỡ rối */
        .mobile-readonly ::placeholder {
            color: transparent;
        }
        /* Căn chỉnh lại text cho dễ đọc hơn trên mobile */
        .mobile-readonly .table td {
            white-space: normal; /* Cho phép xuống dòng */
            min-width: 80px; /* Đảm bảo cột không quá bé */
        }
    }

    @@media (max-width: 767.98px) {
        /* 1. Cột Nội dung: Tăng từ 140px lên 220px */
        .sticky-col-content {
            position: -webkit-sticky;
            position: sticky;
            left: 0;
            z-index: 5;
            background-color: #fff !important;
            border-right: 1px solid #dee2e6;
            min-width: 220px;
            max-width: 220px;
        }
        /* 2. Cột HS Nghỉ: Phải dịch sang phải bằng đúng độ rộng cột trước (220px) */
        .sticky-col-absent {
            position: -webkit-sticky;
            position: sticky;
            z-index: 5;
            background-color: #fff !important;
            border-right: 2px solid #ffc107;
            min-width: 80px;
            max-width: 80px;
            left: 220px;
        }
    }
    /* Thêm style cho textarea tự mở rộng */
    textarea.auto-expand {
        resize: none;
        overflow: hidden;
        min-height: 31px;
        line-height: 1.5;
        transition: height 0.2s ease;
    }
    /* --- CẤU HÌNH MOBILE: CHỈ XEM --- */
    @@media (max-width: 767.98px) {
        /* Cho phép tương tác bấm vào để script chạy */
        .mobile-readonly textarea.auto-expand {
            pointer-events: auto !important;
            caret-color: transparent;
        }
            /* Khi bấm vào (focus): Hiện nền trắng nhưng không hiện viền focus xanh/vàng như lúc sửa */
            .mobile-readonly textarea.auto-expand:focus {
                background-color: #fff !important;
                border: 1px solid #dee2e6 !important;
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
                z-index: 100;
                position: relative;
                outline: none;
            }
    }
</style>

<div class="container-fluid animate-fade-in mobile-readonly">

    <div class="mb-4">
        <partial name="_PageHeader" model="pageHeader" />
    </div>

    @* --- 2. THÊM THÔNG BÁO CHỈ HIỆN TRÊN MOBILE --- *@
    <div class="alert alert-info d-block d-md-none mb-3">
        <i class="fas fa-info-circle"></i> <strong>Chế độ xem</strong>
    </div>

    @* --- BUTTON MOBILE: CẬP NHẬT TIẾT HIỆN TẠI --- *@
    <div class="d-block d-md-none mb-3">
        <button type="button" onclick="openCurrentPeriodModal(@Model.Id)" class="btn btn-primary w-100 shadow-sm">
            <i class="fas fa-clock"></i> Cập nhật tiết học hiện tại
        </button>
    </div>

    <div class="card mb-4 border-warning shadow-sm">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-info-circle"></i> Thông tin Sổ
        </div>
        <div class="card-body bg-light">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Lớp</label>
                    <select asp-for="ClassName" asp-items="Model.AvailableClasses" class="form-select" disabled></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Tuần</label>
                    <input asp-for="WeekNumber" class="form-control" disabled />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Năm học</label>
                    <input asp-for="SchoolYear" class="form-control" disabled />
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <span class="text-muted fst-italic">Đang chỉnh sửa dữ liệu của tuần này.</span>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Edit" method="post" id="formLogbook">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ClassName" />
        <input type="hidden" asp-for="WeekNumber" />
        <input type="hidden" asp-for="SchoolYear" />
        <input type="hidden" asp-for="FromDate" />
        <input type="hidden" asp-for="ToDate" />

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h5 class="m-0 text-primary">
                            Lớp: <span class="fw-bold text-dark fs-5">@Model.ClassName</span>
                        </h5>
                    </div>
                    <div class="col-md-6 text-end text-muted">
                        <i class="far fa-calendar-alt"></i>
                        @Model.FromDate.ToString("dd/MM/yyyy") - @Model.ToDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light text-center align-middle sticky-top">
                            <tr>
                                <th style="width: 50px;">Thứ</th>
                                <th style="width: 50px;">Tiết</th>
                                <th style="width: 100px;">Môn học</th>
                                <th style="width: 80px;">Tiết CT</th>
                                <th>Nội dung / Đầu bài</th>
                                <th style="width: 200px;">HS Nghỉ</th>
                                <th style="width: 60px;">HT<br><small>(4đ)</small></th>
                                <th style="width: 60px;">KL<br><small>(3đ)</small></th>
                                <th style="width: 60px;">VS<br><small>(2đ)</small></th>
                                <th style="width: 60px;">CC<br><small>(1đ)</small></th>
                                <th style="width: 200px;">Nhận xét GV</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.Details.Count; i++)
                            {
                                <tr class="logbook-row">
                                    <input type="hidden" asp-for="Details[i].Id" />
                                    <input type="hidden" name="Details.Index" value="@i" />
                                    <input type="hidden" asp-for="Details[i].DayOfWeek" />
                                    <input type="hidden" asp-for="Details[i].PeriodIndex" />

                                    <td class="text-center fw-bold bg-light">
                                        @if (Model.Details[i].PeriodIndex == 1)
                                        {
                                            <span>T @Model.Details[i].DayOfWeek</span>
                                        }
                                    </td>
                                    <td class="text-center bg-light">@Model.Details[i].PeriodIndex</td>

                                    <td>
                                        <input asp-for="Details[i].SubjectName"
                                               class="form-control form-control-sm subject-input border-0 bg-transparent fw-bold text-primary"
                                               placeholder="..." />
                                    </td>
                                    <td>
                                        <input asp-for="Details[i].CurriculumCode"
                                               class="form-control form-control-sm text-center border-0 bg-transparent" />
                                    </td>
                                    <td>
                                        <textarea asp-for="Details[i].LessonContent"
                                                  rows="1"
                                                  class="form-control form-control-sm border-0 bg-transparent auto-expand"
                                                  placeholder="..."></textarea>
                                    </td>
                                    <td>
                                        <textarea asp-for="Details[i].AbsentStudents"
                                                  rows="1"
                                                  class="form-control form-control-sm border-0 bg-transparent text-danger auto-expand"></textarea>
                                    </td>
                                    <td>
                                        <input asp-for="Details[i].ScoreLearning" type="number" min="0" max="4"
                                               class="form-control form-control-sm text-center score-input border-0 bg-transparent" />
                                    </td>
                                    <td>
                                        <input asp-for="Details[i].ScoreDiscipline" type="number" min="0" max="3"
                                               class="form-control form-control-sm text-center score-input border-0 bg-transparent" />
                                    </td>
                                    <td>
                                        <input asp-for="Details[i].ScoreSanitation" type="number" min="0" max="2"
                                               class="form-control form-control-sm text-center score-input border-0 bg-transparent" />
                                    </td>
                                    <td>
                                        <input asp-for="Details[i].ScoreDiligent" type="number" min="0" max="1"
                                               class="form-control form-control-sm text-center score-input border-0 bg-transparent" />
                                    </td>
                                    <td>
                                        <textarea asp-for="Details[i].TeacherComment"
                                                  rows="1"
                                                  class="form-control form-control-sm border-0 bg-transparent auto-expand"></textarea>
                                    </td>
                                </tr>

                                @if (Model.Details[i].PeriodIndex == 5)
                                {
                                    <tr class="table-secondary"><td colspan="12"></td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-white sticky-bottom border-top">
                <div class="row">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Nhận xét chung của GVCN:</label>
                        <textarea asp-for="HomeroomTeacherComment" class="form-control bg-light" rows="2"></textarea>
                    </div>

                    @* --- 3. ẨN NÚT LƯU TRÊN MOBILE --- *@
                    <div class="col-md-4 align-items-end justify-content-end gap-2 d-none d-md-flex">
                        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="fas fa-save"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "5000"
        };
    </script>
    <script>
        document.getElementById('formLogbook')?.addEventListener('submit', function (e) {
            const rows = document.querySelectorAll('tr.logbook-row');
            let isValid = true;
            let errorMsg = "";
            rows.forEach((row, index) => {
                const subjectInput = row.querySelector('.subject-input');
                const contentInput = row.querySelector('input[name$=".LessonContent"]');

                if (!subjectInput || !contentInput) return;

                const hasSubject = subjectInput.value.trim() !== "";
                const hasContent = contentInput.value.trim() !== "";

                subjectInput.classList.remove('border', 'border-danger', 'bg-warning', 'bg-opacity-10');
                contentInput.classList.remove('border', 'border-danger', 'bg-warning', 'bg-opacity-10');

                if (!hasSubject && !hasContent) {
                    const allInputs = row.querySelectorAll('input, select, textarea');
                    allInputs.forEach(input => input.disabled = true);
                }
                else if ((hasSubject && !hasContent) || (!hasSubject && hasContent)) {
                    isValid = false;
                    if (!hasSubject) subjectInput.classList.add('border', 'border-danger', 'bg-warning', 'bg-opacity-10');
                    if (!hasContent) contentInput.classList.add('border', 'border-danger', 'bg-warning', 'bg-opacity-10');

                    const day = row.querySelector('input[name$=".DayOfWeek"]')?.value;
                    const period = row.querySelector('input[name$=".PeriodIndex"]')?.value;
                    errorMsg += `\n- Thứ ${day}, Tiết ${period}: Nhập thiếu Môn học hoặc Nội dung.`;
                    const allInputs = row.querySelectorAll('input, select, textarea');
                    allInputs.forEach(input => input.disabled = false);
                }
                else {
                    const allInputs = row.querySelectorAll('input, select, textarea');
                    allInputs.forEach(input => input.disabled = false);
                }
            });
            if (!isValid) {
                e.preventDefault();
                rows.forEach(row => {
                     const allInputs = row.querySelectorAll('input, select, textarea');
                     allInputs.forEach(input => input.disabled = false);
                });
                alert("Vui lòng kiểm tra lại thông tin:" + errorMsg);
            }
        });

        function openCurrentPeriodModal(logbookId) {
            fetch(`/ClassLogbook/GetCurrentPeriodModal?logbookId=${logbookId}`)
                .then(async response => {
                    if (response.ok) {
                        return response.text();
                    } else {
                        const errorText = await response.text();
                        toastr.error(errorText, "Đã xảy ra lỗi!");
                        throw new Error(errorText);
                    }
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    const modalElement = document.getElementById('currentPeriodModal');
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                })
                .catch(error => console.error('Lỗi:', error));
        }

        function submitCurrentPeriod(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            fetch('/ClassLogbook/UpdatePeriodDetail', {
                method: 'POST',
                body: formData
            })
            .then(async response => {
                if (response.ok) {
                    toastr.success("Cập nhật thành công!", "Thông báo");
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    const errorText = await response.text();
                    toastr.error(errorText, "Lỗi cập nhật");
                }
            })
            .catch(error => {
                toastr.error("Đã xảy ra lỗi kết nối.", "Lỗi mạng");
            });
        }

        $(document).ready(function () {
            $(document).on('focus input', 'textarea.auto-expand', function () {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });

            $(document).on('blur', 'textarea.auto-expand', function () {
                this.style.height = '';
            });
        });

        $(document).ready(function () {
            function applyMobileReadonly() {
                var isMobile = $(window).width() < 768;
                $('textarea.auto-expand').each(function() {
                    if (isMobile) {
                        $(this).attr('readonly', 'readonly');
                    } else {
                        $(this).removeAttr('readonly');
                    }
                });
            }
            applyMobileReadonly();
            $(window).resize(function() {
                applyMobileReadonly();
            });

            $(document).on('focus input', 'textarea.auto-expand', function () {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });
            $(document).on('blur', 'textarea.auto-expand', function () {
                this.style.height = '';
            });
        });
    </script>
}