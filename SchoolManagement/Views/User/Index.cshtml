@using SchoolManagement.Models
@model SchoolManagement.Common.PagedResult<SchoolManagement.Models.UserRolesViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
    var currentKeyword = ViewData["Keyword"] as string;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-header bg-white py-4 border-bottom-0">
            <div class="row align-items-center gy-3">

                <div class="col-lg-4 col-md-12">
                    <h5 class="mb-0 text-primary fw-bold">
                        <i class="fas fa-users-cog me-2"></i>Danh sách người dùng
                    </h5>
                    <p class="text-muted small mb-0 mt-1">Quản lý tài khoản và phân quyền hệ thống</p>
                </div>

                <div class="col-lg-8 col-md-12">
                    <div class="d-flex flex-column flex-md-row justify-content-lg-end gap-2">
                        <form asp-action="Index" method="get" class="flex-grow-1 flex-md-grow-0" style="min-width: 300px;">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-search text-muted"></i>
                                </span>
                                <input type="text" name="keyword" class="form-control bg-light border-start-0 ps-0"
                                       placeholder="Tìm theo tên, email..." value="@currentKeyword" />
                                <button class="btn btn-primary" type="submit">Tìm</button>
                                @if (!string.IsNullOrEmpty(currentKeyword))
                                {
                                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa lọc">
                                        <i class="fas fa-times"></i>
                                    </a>
                                }
                            </div>
                        </form>

                        <a asp-action="Create" class="btn btn-success shadow-sm">
                            <i class="fas fa-plus me-1"></i> <span class="d-none d-md-inline">Thêm mới</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 mobile-responsive-table w-100">
                    <thead class="bg-light text-uppercase text-secondary small">
                        <tr>
                            <th class="py-3 ps-4 border-0">Thông tin tài khoản</th>
                            <th class="py-3 border-0">Vai trò (Roles)</th>
                            <th class="py-3 border-0 text-center" style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items != null && Model.Items.Any())
                        {
                            foreach (var user in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4" data-label="Tài khoản">
                                        <div class="d-flex align-items-center user-info-wrapper">

                                            @* --- LOGIC AVATAR MỚI --- *@
                                            @{
                                                // Kiểm tra đường dẫn ảnh.
                                                // Lưu ý: Url.Content giúp chuyển đổi dấu "~" thành đường dẫn thực tế
                                                var avatarSrc = !string.IsNullOrEmpty(user.Avatar)
                                                ? user.Avatar
                                                : Url.Content("~/images/default-avatar.png");
                                            }

                                            <img src="@avatarSrc"
                                                 alt="User Avatar"
                                                 class="avatar-img me-3 flex-shrink-0"
                                                 onerror="this.onerror=null; this.src='@Url.Content("~/images/default-avatar.png")';" />
                                            @* onerror giúp tự động fallback về ảnh mặc định nếu link ảnh user bị lỗi (404) *@

                                            <div>
                                                <div class="fw-bold text-dark text-break">@user.Email</div>
                                                <div class="small text-muted">ID: <span class="font-monospace">@user.UserId</span></div>
                                            </div>
                                        </div>
                                    </td>

                                    <td data-label="Phân quyền">
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1 justify-content-md-start justify-content-end">
                                                @foreach (var role in user.Roles)
                                                {
                                                    // Logic màu sắc badge: Admin màu đỏ nhạt, khác màu xanh nhạt
                                                    var isSuper = role.ToLower().Contains("admin") || role.ToLower().Contains("quản trị");
                                                    var badgeClass = isSuper ? "badge-soft-danger" : "badge-soft-primary";

                                                    <span class="badge @badgeClass rounded-pill border px-3 py-2">
                                                        @role
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Chưa phân quyền</span>
                                        }
                                    </td>

                                    <td class="text-center" data-label="Hành động">
                                        <div class="d-flex justify-content-center justify-content-md-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-outline-primary" title="Sửa">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            <form asp-action="Delete" asp-route-id="@user.UserId" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng @user.Email không? Hành động này không thể hoàn tác.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                                        <p class="mb-1">Không tìm thấy kết quả nào cho "<strong>@currentKeyword</strong>"</p>
                                        <a asp-action="Index" class="btn btn-link text-decoration-none">Tải lại danh sách</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white py-3 border-top">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Hiển thị <strong>@Model.Items.Count</strong> / <strong>@Model.TotalRecords</strong> bản ghi
                </div>
                <div>
                    <partial name="_Pagination" model="Model" />
                </div>
            </div>
        </div>
    </div>
</div>