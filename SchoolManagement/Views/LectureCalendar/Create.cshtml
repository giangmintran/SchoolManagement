@using SchoolManagement.Models.ViewModels
@model SchoolManagement.Models.LectureCalendarCreateViewModel

@{
    ViewData["Title"] = "Tạo Lịch Báo Giảng";
    var pageHeader = new PageHeaderViewModel
    {
        Title = "Tạo mới lịch báo giảng",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem { Title = "Danh sách", Url = Url.Action("Index") },
            new BreadcrumbItem { Title = "Tạo mới", IsActive = true }
        }
    };
}

<div class="container-fluid animate-fade-in">
    <div class="mb-3">
        <partial name="_PageHeader" model="pageHeader" />
    </div>

    <form asp-action="Create" id="createForm">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white d-flex align-items-center">
                <i class="fa fa-info-circle me-2"></i>
                <h5 class="mb-0 fs-6 fs-md-5">Thông tin chung</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="TeacherName" class="form-label fw-bold text-secondary small text-uppercase">Tên Giáo viên</label>
                            <input asp-for="TeacherName" class="form-control" placeholder="Nhập tên giáo viên..." />
                            <span asp-validation-for="TeacherName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label asp-for="Week" class="form-label fw-bold text-secondary small text-uppercase">Tuần</label>
                            <input asp-for="Week" class="form-control" type="number" min="1" max="52" placeholder="Ví dụ: 1" />
                            <span asp-validation-for="Week" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="StartDate" class="form-label fw-bold text-secondary small text-uppercase">Từ ngày</label>
                            <input asp-for="StartDate" class="form-control" id="StartDate" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="EndDate" class="form-label fw-bold text-secondary small text-uppercase">Đến ngày</label>
                            <input asp-for="EndDate" class="form-control" id="EndDate" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top text-end">
                    <button type="button" class="btn btn-warning shadow-sm" onclick="generateScheduleTable()">
                        <i class="fa fa-table me-1"></i> Tạo lưới (Tự động 5 tiết/ngày)
                    </button>
                </div>
            </div>
        </div>

        <div id="detailsSection" style="display:none;" class="card shadow-sm border-0 mb-5">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 text-primary"><i class="fa fa-list-alt me-2"></i>Chi tiết giảng dạy</h5>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 align-middle" id="detailsTable">
                        <thead class="bg-light text-secondary text-center text-uppercase small fw-bold">
                            <tr>
                                <th style="width: 120px;">Ngày</th>
                                <th style="width: 60px;">Tiết</th>
                                <th style="width: 100px;">Lớp</th>
                                <th style="min-width: 150px;">Môn học</th>
                                <th style="width: 80px;">PPCT</th>
                                <th style="min-width: 200px;">Tên bài dạy</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-white border-top-0 py-3">
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-success shadow-sm px-4">
                        <i class="fa fa-save me-1"></i> Lưu Lịch Báo Giảng
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // 1. Hàm sinh lưới 5 tiết mỗi ngày
        function generateScheduleTable() {
            var startDateVal = $("#StartDate").val();
            var endDateVal = $("#EndDate").val();

            if (!startDateVal || !endDateVal) {
                alert("Vui lòng chọn Từ ngày và Đến ngày trước.");
                return;
            }

            var start = new Date(startDateVal);
            var end = new Date(endDateVal);

            if (end < start) {
                 alert("Ngày kết thúc phải lớn hơn ngày bắt đầu.");
                return;
            }

            var tbody = $("#detailsTable tbody");
            tbody.empty();
            var globalIndex = 0; // Index chạy liên tục cho toàn bộ mảng Details[...]

            // Vòng lặp từng ngày
            for (var d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {

                // Bỏ qua Chủ nhật (nếu muốn - uncomment dòng dưới)
                // if (d.getDay() === 0) continue;

                var displayDate = d.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit' });
                var dateInputVal = d.toISOString().split('T')[0];

                // Xác định màu nền cho ngày chủ nhật nếu có
                var isSunday = d.getDay() === 0;
                var rowClass = isSunday ? "table-warning" : "";

                // Vòng lặp 5 tiết cho mỗi ngày
                for (var period = 1; period <= 5; period++) {

                    var isFirstRowOfDay = (period === 1);
                    var tr = $("<tr>").addClass(rowClass);

                    // Cột NGÀY: Chỉ hiện ở dòng đầu tiên của ngày (dùng rowspan=5)
                    if (isFirstRowOfDay) {
                        tr.append(`
                            <td class="align-middle text-center bg-white" rowspan="5">
                                <div class="fw-bold text-primary">${displayDate.split(' ')[0]}</div>
                                <div class="small text-muted">${displayDate.split(' ')[1]}</div>
                            </td>
                        `);
                    }

                    // Các cột input dữ liệu
                    tr.append(`
                        <td class="text-center align-middle">
                            <input type="hidden" name="Details[${globalIndex}].Date" value="${dateInputVal}" />
                            <span class="fw-bold text-secondary">${period}</span>
                            <input type="hidden" name="Details[${globalIndex}].Period" value="${period}" />
                        </td>
                        <td class="p-1">
                            <input type="text" name="Details[${globalIndex}].Class" class="form-control form-control-sm text-center border-0 bg-transparent fw-bold text-info" placeholder="..." />
                        </td>
                        <td class="p-1">
                            <input type="text" name="Details[${globalIndex}].Subject" class="form-control form-control-sm border-0 bg-transparent fw-semibold" placeholder="..." />
                        </td>
                        <td class="p-1">
                            <input type="number" name="Details[${globalIndex}].Lesson" class="form-control form-control-sm text-center border-0 bg-transparent" placeholder="..." />
                        </td>
                        <td class="p-1">
                            <input type="text" name="Details[${globalIndex}].LessonTitle" class="form-control form-control-sm border-0 bg-transparent fw-bold text-primary" placeholder="..." />
                        </td>
                        <td class="p-1">
                            <input type="text" name="Details[${globalIndex}].Note" class="form-control form-control-sm border-0 bg-transparent text-muted fst-italic" placeholder="..." />
                        </td>
                    `);
                    tbody.append(tr);
                    globalIndex++; // Tăng index sau mỗi dòng tiết
                }

                // Thêm một dòng ngăn cách mờ giữa các ngày
                tbody.append('<tr class="border-top border-2 border-light"></tr>');
            }

            $("#detailsSection").fadeIn();

            // Cuộn xuống bảng vừa tạo
            $('html, body').animate({
                scrollTop: $("#detailsSection").offset().top - 100
            }, 500);
        }
    </script>

    <style>
        /* CSS nội bộ để làm đẹp input trong bảng giống file Details */
        #detailsTable input.form-control {
            border-radius: 0;
            box-shadow: none;
        }

            #detailsTable input.form-control:focus {
                background-color: #fff !important;
                border-bottom: 2px solid #0d6efd !important;
            }
        /* Placeholder styling */
        #detailsTable input::placeholder {
            color: #dee2e6;
            font-size: 0.8rem;
        }
    </style>
}