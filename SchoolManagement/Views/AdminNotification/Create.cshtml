@using SchoolManagement.Models.ViewModels
@model SchoolManagement.Models.ViewModels.CreateNotificationViewModel

@{
    ViewData["Title"] = "Tạo thông báo mới";

    // Cấu hình Header
    var pageHeader = new PageHeaderViewModel
    {
        Title = "Tạo thông báo",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem { Title = "Danh sách", Url = Url.Action("Index") },
            new BreadcrumbItem { Title = "Tạo mới", IsActive = true }
        }
    };
}

<div class="container-fluid animate-fade-in">
    <div class="mb-3">
        <partial name="_PageHeader" model="pageHeader" />
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="notificationForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2 border-0 shadow-sm" role="alert"></div>

                        <div class="mb-2">
                            <label asp-for="Title" class="form-label fw-bold text-secondary">
                                <i class="bi bi-type me-1"></i> Tiêu đề thông báo
                            </label>
                            <input asp-for="Title" class="form-control border-2 shadow-sm" placeholder="Nhập tiêu đề ngắn gọn..." />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="Type" class="form-label fw-bold text-secondary">
                                    <i class="bi bi-tags-fill me-1"></i> Loại thông báo
                                </label>
                                <select asp-for="Type" class="form-select border-2 shadow-sm" style="cursor: pointer;">
                                    <option value="">-- Vui lòng chọn loại thông báo --</option>
                                    <option value="1">Thông báo hệ thống</option>
                                    <option value="2">Nhắc nhở</option>
                                    <option value="3">Khác</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RedirectUrl" class="form-label fw-bold text-secondary">
                                    <i class="bi bi-link-45deg me-1"></i> Đường dẫn chuyển hướng (nếu có)
                                </label>
                                <input asp-for="RedirectUrl" type="text" class="form-control border-2 shadow-sm" placeholder="Nhập đường dẫn (URL) nếu có..." />
                                <span asp-validation-for="RedirectUrl" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Content" class="form-label fw-bold text-secondary">
                                <i class="bi bi-chat-left-text-fill me-1"></i> Nội dung chi tiết
                            </label>
                            <textarea asp-for="Content" class="form-control border-2 shadow-sm" rows="6" placeholder="Viết nội dung thông báo tại đây..."></textarea>
                            <span asp-validation-for="Content" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="card border-1 border-light shadow-sm rounded-4 mb-4 bg-light">
                            <div class="card-body p-4">
                                <div class="form-check form-switch d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                                    <input class="form-check-input custom-switch" type="checkbox" asp-for="SendToAll" id="chkSendToAll" style="cursor: pointer;">
                                    <label class="form-check-label fw-bold text-primary mb-0" asp-for="SendToAll" style="cursor: pointer;">
                                        Gửi cho tất cả người dùng hệ thống
                                    </label>
                                </div>

                                <div id="userSelectionGroup">
                                    <div class="d-flex justify-content-between align-items-end mb-3">
                                        <label class="form-label fw-bold text-secondary mb-0">
                                            <i class="bi bi-people-fill me-1"></i> Hoặc chọn người nhận cụ thể
                                        </label>

                                        <div class="d-flex align-items-center gap-2">
                                            <span class="small text-muted">Hiển thị:</span>
                                            <select id="rowsPerPage" class="form-select form-select-sm border-secondary shadow-sm" style="width: 80px; cursor: pointer;">
                                                <option value="5">5</option>
                                                <option value="10" selected>10</option>
                                                <option value="20">20</option>
                                                <option value="50">50</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div id="tableWrapper" class="bg-white rounded-3 custom-table-wrapper overflow-hidden">
                                        <table class="table custom-table align-middle mb-0 w-100" id="usersTable">
                                            <thead class="position-sticky top-0 z-1">
                                                <tr>
                                                    <th class="text-center bg-light border-bottom" style="width: 70px;">
                                                        <div class="form-check d-flex justify-content-center mb-0">
                                                            <input class="form-check-input custom-checkbox border-secondary" type="checkbox" id="selectAllUsers" style="cursor: pointer;" title="Chọn tất cả danh sách">
                                                        </div>
                                                    </th>
                                                    <th class="bg-light border-bottom text-secondary fw-bold py-3">Họ và tên / Tài khoản</th>
                                                </tr>
                                            </thead>
                                            <tbody id="usersTableBody">
                                                @if (Model.AvailableUsers != null && Model.AvailableUsers.Any())
                                                {
                                                    foreach (var user in Model.AvailableUsers)
                                                    {
                                                        <tr class="user-row">
                                                            <td class="text-center border-bottom-0">
                                                                <div class="form-check d-flex justify-content-center mb-0">
                                                                    <input class="form-check-input user-checkbox custom-checkbox border-secondary" type="checkbox" name="SelectedUserIds" value="@user.Value" id="user_@user.Value" style="cursor: pointer;" @(user.Selected ? "checked" : "")>
                                                                </div>
                                                            </td>
                                                            <td class="border-bottom-0">
                                                                <label class="form-check-label d-block w-100 py-2 fw-medium text-dark text-wrap text-break" for="user_@user.Value" style="cursor: pointer;">
                                                                    @user.Text
                                                                </label>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr id="emptyRow">
                                                        <td colspan="2" class="text-center text-muted py-4">Không có người dùng nào để chọn</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 gap-3">
                                        <div class="small text-muted fw-medium" id="pageInfo">
                                            Đang hiển thị <span id="startIndex">0</span> - <span id="endIndex">0</span> / <span id="totalRecords">0</span> người dùng
                                        </div>
                                        <nav aria-label="Điều hướng phân trang">
                                            <ul class="pagination pagination-sm mb-0 shadow-sm" id="paginationControls">
                                            </ul>
                                        </nav>
                                    </div>

                                    <span asp-validation-for="SelectedUserIds" class="text-danger small mt-2 d-block"></span>
                                </div>
                            </div>
                        </div>

                        

                        <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-medium">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-bold rounded-pill shadow">
                                Gửi ngay <i class="bi bi-send-fill ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f6f9;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, .15);
    }

    .custom-switch {
        width: 3rem !important;
        height: 1.5rem !important;
    }

    /* Cập nhật CSS cho bảng: ẩn overflow ngang và đảm bảo table giãn 100% */
    .custom-table-wrapper {
        border: 1px solid #e9ecef;
        box-shadow: inset 0 0 5px rgba(0,0,0,0.02);
    }

    .custom-table {
        table-layout: fixed;
        width: 100%;
    }

        .custom-table th {
            letter-spacing: 0.5px;
            text-transform: uppercase;
            font-size: 0.75rem;
        }

        .custom-table td {
            word-wrap: break-word;
            white-space: normal;
        }

        .custom-table .user-row {
            transition: all 0.2s ease-in-out;
            border-bottom: 1px solid #f1f3f5;
        }

            .custom-table .user-row:hover {
                background-color: #e9ecef;
                transform: translateX(2px);
            }

            .custom-table .user-row:last-child {
                border-bottom: none;
            }

    .custom-checkbox {
        width: 1.3rem;
        height: 1.3rem;
        transition: all 0.2s;
    }

        .custom-checkbox:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
            transform: scale(1.1);
        }

    .table-wrapper-active {
        border: 2px solid #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, .15) !important;
    }

    .btn-primary {
        background: linear-gradient(45deg, #0d6efd, #0b5ed7);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(13,110,253,0.3) !important;
        }
    /* Pagination Custom Styles */
    .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .page-link {
        color: #495057;
        cursor: pointer;
    }

        .page-link:hover {
            background-color: #e9ecef;
        }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- CÁC PHẦN TỬ DOM ---
            const chkSendToAll = document.getElementById('chkSendToAll');
            const selectAllUsers = document.getElementById('selectAllUsers');
            const userCheckboxes = document.querySelectorAll('.user-checkbox');
            const tableWrapper = document.getElementById('tableWrapper');
            const userRows = Array.from(document.querySelectorAll('.user-row'));

            // --- BIẾN PHÂN TRANG ---
            const rowsPerPageSelect = document.getElementById('rowsPerPage');
            const paginationControls = document.getElementById('paginationControls');
            const startIndexEl = document.getElementById('startIndex');
            const endIndexEl = document.getElementById('endIndex');
            const totalRecordsEl = document.getElementById('totalRecords');

            let currentPage = 1;
            let rowsPerPage = parseInt(rowsPerPageSelect.value);
            const totalRows = userRows.length;

            if (totalRecordsEl) totalRecordsEl.textContent = totalRows;

            // --- HÀM PHÂN TRANG (PAGINATION) ---
            function renderTable() {
                if (totalRows === 0) return;

                const totalPages = Math.ceil(totalRows / rowsPerPage);
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const startIndex = (currentPage - 1) * rowsPerPage;
                const endIndex = Math.min(startIndex + rowsPerPage, totalRows);

                startIndexEl.textContent = totalRows === 0 ? 0 : startIndex + 1;
                endIndexEl.textContent = endIndex;

                userRows.forEach((row, index) => {
                    if (index >= startIndex && index < endIndex) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });

                renderPaginationControls(totalPages);
            }

            function renderPaginationControls(totalPages) {
                paginationControls.innerHTML = '';
                if (totalPages <= 1) return;

                const prevLi = document.createElement('li');
                prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
                prevLi.innerHTML = `<a class="page-link" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a>`;
                prevLi.addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderTable(); } });
                paginationControls.appendChild(prevLi);

                for (let i = 1; i <= totalPages; i++) {
                    if (totalPages > 7) {
                        if (i !== 1 && i !== totalPages && (i < currentPage - 1 || i > currentPage + 1)) {
                            if (i === currentPage - 2 || i === currentPage + 2) {
                                const dotsLi = document.createElement('li');
                                dotsLi.className = 'page-item disabled';
                                dotsLi.innerHTML = `<a class="page-link">...</a>`;
                                paginationControls.appendChild(dotsLi);
                            }
                            continue;
                        }
                    }

                    const pageLi = document.createElement('li');
                    pageLi.className = `page-item ${currentPage === i ? 'active' : ''}`;
                    pageLi.innerHTML = `<a class="page-link">${i}</a>`;
                    pageLi.addEventListener('click', () => { currentPage = i; renderTable(); });
                    paginationControls.appendChild(pageLi);
                }

                const nextLi = document.createElement('li');
                nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
                nextLi.innerHTML = `<a class="page-link" aria-label="Next"><span aria-hidden="true">&raquo;</span></a>`;
                nextLi.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; renderTable(); } });
                paginationControls.appendChild(nextLi);
            }

            rowsPerPageSelect.addEventListener('change', function() {
                rowsPerPage = parseInt(this.value);
                currentPage = 1;
                renderTable();
            });

            // --- HÀM XỬ LÝ CHECKBOX ĐỒNG BỘ ---
            function setAllCheckboxes(isChecked) {
                userCheckboxes.forEach(cb => { cb.checked = isChecked; });
                if (selectAllUsers) selectAllUsers.checked = isChecked;
                if (chkSendToAll) chkSendToAll.checked = isChecked;

                if(isChecked) tableWrapper.classList.add('table-wrapper-active');
                else tableWrapper.classList.remove('table-wrapper-active');
            }

            function verifyCheckStates() {
                const total = userCheckboxes.length;
                const checkedCount = document.querySelectorAll('.user-checkbox:checked').length;
                const isAllChecked = (total > 0 && total === checkedCount);

                if (selectAllUsers) selectAllUsers.checked = isAllChecked;
                if (chkSendToAll) chkSendToAll.checked = isAllChecked;

                if(isAllChecked) tableWrapper.classList.add('table-wrapper-active');
                else tableWrapper.classList.remove('table-wrapper-active');
            }

            if (chkSendToAll) chkSendToAll.addEventListener('change', function() { setAllCheckboxes(this.checked); });
            if (selectAllUsers) selectAllUsers.addEventListener('change', function() { setAllCheckboxes(this.checked); });
            userCheckboxes.forEach(cb => { cb.addEventListener('change', function() { verifyCheckStates(); }); });

            // --- KHỞI TẠO BAN ĐẦU ---
            renderTable();
            verifyCheckStates();
        });
    </script>
}