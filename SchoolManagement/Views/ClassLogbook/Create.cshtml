@model SchoolManagement.Models.LogbookUpsertViewModel

@{
    ViewData["Title"] = "Lập Sổ Đầu Bài";
}

@* --- CUSTOM CSS CHO TRANG NÀY --- *@
<style>
    /* Làm đẹp Card */
    .card-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        transition: all 0.3s ease;
    }

        .card-custom:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

    /* Header bảng cố định (Sticky Header) */
    .table-responsive {
        max-height: 70vh;
        overflow-y: auto;
    }

    thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #f8f9fa !important; /* Màu nền header */
        color: #495057;
        font-weight: 600;
        vertical-align: middle !important;
        box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1); /* Bóng nhẹ dưới header */
    }

    /* Ô nhập liệu phong cách Excel */
    .grid-input {
        border: 1px solid transparent;
        border-radius: 4px;
        padding: 4px 8px;
        transition: all 0.2s;
        background-color: transparent;
        width: 100%;
    }

        .grid-input:hover {
            background-color: #f1f3f5;
        }

        .grid-input:focus {
            background-color: #fff;
            border-color: #86b7fe;
            outline: 0;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    /* Căn chỉnh cột điểm số */
    .score-col input {
        text-align: center;
        font-weight: 600;
    }

    /* Cột Thứ và Tiết */
    .col-fixed-info {
        background-color: #e9ecef !important;
        font-weight: bold;
        color: #495057;
        vertical-align: middle;
    }

    /* Dòng ngăn cách buổi (Tiết 5) */
    .separator-row td {
        background-color: #dee2e6 !important;
        height: 8px;
        padding: 0 !important;
    }
</style>

<div class="container-fluid py-3">

    @* --- HEADER & BACK BUTTON --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary m-0"><i class="fas fa-book-open me-2"></i>Quản lý Sổ đầu bài</h2>
            <p class="text-muted m-0 small">Nhập liệu và theo dõi nề nếp học tập</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="fas fa-arrow-left me-1"></i> <span class="d-none d-md-inline ms-1">Quay lại</span>
        </a>
    </div>

    @* --- BỘ LỌC (FILTER CARD) --- *@
    <div class="card card-custom mb-4">
        <div class="card-body p-4">
            <form asp-action="Create" method="get" class="row g-3 align-items-end" id="formSearchLogbook">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary text-uppercase small">Lớp học</label>
                    <select asp-for="ClassName" asp-items="Model.AvailableClasses" class="form-select form-select-lg shadow-none" id="ClassName">
                        <option value="">-- Chọn lớp --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary text-uppercase small">Tuần học</label>
                    <input asp-for="WeekNumber" class="form-control form-control-lg shadow-none" type="number" placeholder="Ví dụ: 1" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary text-uppercase small">Năm học</label>
                    <input asp-for="SchoolYear" class="form-control form-control-lg shadow-none" placeholder="2025-2026" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                        <i class="fas fa-search me-1"></i> Lập Sổ
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* --- FORM NHẬP LIỆU CHÍNH --- *@
    @if (!string.IsNullOrEmpty(Model.ClassName) && Model.Details != null && Model.Details.Any())
    {
        <form asp-action="Create" method="post" id="formLogbook">
            <input type="hidden" asp-for="ClassName" />
            <input type="hidden" asp-for="WeekNumber" />
            <input type="hidden" asp-for="SchoolYear" />
            <input type="hidden" asp-for="FromDate" />
            <input type="hidden" asp-for="ToDate" />

            <div class="card card-custom shadow">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                <i class="fas fa-calendar-check fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="m-0 fw-bold text-dark">Lớp @Model.AvailableClasses?.FirstOrDefault(c => c.Value == Model.ClassName.ToString())?.Text</h5>
                                <span class="text-muted small">
                                    <i class="far fa-clock me-1"></i> @Model.FromDate.ToString("dd/MM/yyyy") - @Model.ToDate.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">
                                Tuần @Model.WeekNumber
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered mb-0 align-middle">
                            <thead>
                                <tr class="text-center text-uppercase small">
                                    <th style="width: 60px;">Thứ</th>
                                    <th style="width: 50px;">Tiết</th>
                                    <th style="min-width: 160px;">Môn học</th>
                                    <th style="width: 80px;">Tiết PPCT</th>
                                    <th style="min-width: 200px;">Nội dung / Đầu bài</th>
                                    <th style="min-width: 100px;">HS Nghỉ</th>
                                    <th class="text-success" style="width: 70px;">Học Tập<br>(4đ)</th>
                                    <th class="text-warning" style="width: 70px;">Kỷ Luật<br>(3đ)</th>
                                    <th class="text-info" style="width: 70px;">Vệ Sinh<br>(2đ)</th>
                                    <th class="text-danger" style="width: 70px;">Chuyên Cần<br>(1đ)</th>
                                    <th style="min-width: 180px;">Nhận xét GV</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Details.Count; i++)
                                {
                                    <tr class="logbook-row">
                                        @* Hidden Fields *@
                                        <input type="hidden" name="Details.Index" value="@i" />
                                        <input type="hidden" asp-for="Details[i].DayOfWeek" />
                                        <input type="hidden" asp-for="Details[i].PeriodIndex" />
                                        <input type="hidden" asp-for="Details[i].Date" />

                                        <td class="text-center col-fixed-info">
                                            @if (Model.Details[i].PeriodIndex == 1)
                                            {
                                                <div class="d-flex flex-column align-items-center">
                                                    <span class="fs-5">@Model.Details[i].DayOfWeek</span>
                                                    <small class="fw-normal text-muted" style="font-size: 0.7rem">@Model.Details[i].Date.ToString("dd/MM")</small>
                                                </div>
                                            }
                                        </td>

                                        <td class="text-center col-fixed-info">
                                            @Model.Details[i].PeriodIndex
                                        </td>

                                        <td>
                                            <input asp-for="Details[i].SubjectName" class="grid-input subject-input fw-bold text-primary" placeholder="" />
                                        </td>
                                        <td>
                                            <input asp-for="Details[i].CurriculumCode" class="grid-input text-center" />
                                        </td>
                                        <td>
                                            <input asp-for="Details[i].LessonContent" class="grid-input" placeholder="" />
                                        </td>
                                        <td>
                                            <input asp-for="Details[i].AbsentStudents" class="grid-input text-danger" placeholder="" />
                                        </td>

                                        <td class="score-col">
                                            <input asp-for="Details[i].ScoreLearning" type="number" min="0" max="4" class="grid-input" tabindex="@(i * 10 + 1)" />
                                        </td>
                                        <td class="score-col">
                                            <input asp-for="Details[i].ScoreDiscipline" type="number" min="0" max="3" class="grid-input" tabindex="@(i * 10 + 2)" />
                                        </td>
                                        <td class="score-col">
                                            <input asp-for="Details[i].ScoreSanitation" type="number" min="0" max="2" class="grid-input" tabindex="@(i * 10 + 3)" />
                                        </td>
                                        <td class="score-col">
                                            <input asp-for="Details[i].ScoreDiligent" type="number" min="0" max="1" class="grid-input" tabindex="@(i * 10 + 4)" />
                                        </td>

                                        <td>
                                            <input asp-for="Details[i].TeacherComment" class="grid-input" />
                                        </td>
                                    </tr>

                                    @if (Model.Details[i].PeriodIndex == 5)
                                    {
                                        <tr class="separator-row">
                                            <td colspan="11"></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light p-4">
                    <label class="form-label fw-bold text-dark"><i class="fas fa-comment-dots text-primary me-2"></i>Nhận xét chung của GVCN tuần này:</label>
                    <textarea asp-for="HomeroomTeacherComment" class="form-control shadow-sm" rows="3" placeholder="Nhập đánh giá chung về tình hình lớp học..."></textarea>

                    <div class="mt-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light border shadow-sm px-4" onclick="window.location.reload()">
                            <i class="fas fa-sync-alt me-1"></i> Hủy / Tải lại
                        </button>
                        <button type="submit" class="btn btn-success shadow px-5 fw-bold">
                            <i class="fas fa-save me-1"></i> LƯU SỔ ĐẦU BÀI
                        </button>
                    </div>
                </div>
            </div>
        </form>
    }
    else if (Context.Request.Query.ContainsKey("ClassId"))
    {
        <div class="alert alert-info shadow-sm mt-4 text-center border-0 bg-white">
            <div class="py-4">
                <i class="fas fa-info-circle fa-2x text-info mb-3"></i>
                <h5 class="fw-bold text-secondary">Không tìm thấy dữ liệu</h5>
                <p class="mb-0">Chưa có dữ liệu thời khóa biểu cho tuần này hoặc lớp học chưa được cấu hình.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('formLogbook')?.addEventListener('submit', function (e) {
            const rows = document.querySelectorAll('tr.logbook-row');
            rows.forEach(row => {
                const subjectInput = row.querySelector('.subject-input');
                // Nếu không có tên môn học -> disable row để không submit rác
                if (subjectInput && subjectInput.value.trim() === "") {
                    const allInputs = row.querySelectorAll('input, select, textarea');
                    allInputs.forEach(input => input.disabled = true);
                }
            });
        });

        // UX: Tự động chọn tất cả text khi click vào ô điểm để sửa nhanh
        document.querySelectorAll('.score-col input').forEach(input => {
            input.addEventListener('focus', function() {
                this.select();
            });
        });
    </script>
}