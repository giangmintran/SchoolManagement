@using SchoolManagement.Common
@using SchoolManagement.Data.Entities
@model PagedResult<ClassLogbook>

@{
    ViewData["Title"] = "Quản lý Sổ đầu bài";
    // Ép kiểu các ViewBag để dùng lại trong form
    var selectedWeek = ViewBag.SelectedWeek as int?;
    var selectedDate = ViewBag.SelectedDate as DateTime?;
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fas fa-book-open text-primary me-2"></i>Sổ đầu bài
            </h4>
            <small class="text-muted">Quản lý, theo dõi nề nếp và học tập các lớp</small>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-1"></i> Lập sổ mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">

        <div class="card-header bg-white border-bottom-0 pt-4 px-4">
            <form method="get" asp-action="Index">
                <div class="search-container">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Lớp học</label>
                            <select name="className" class="form-select border-0 shadow-sm" asp-items="ViewBag.Classes">
                                <option value="">-- Tất cả --</option>
                            </select>
                        </div>

                        <div class="col-md-2 col-sm-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Tuần học</label>
                            <input type="number" name="weekNumber" class="form-control border-0 shadow-sm"
                                   placeholder="VD: 1" value="@selectedWeek">
                        </div>

                        <div class="col-md-3 col-sm-12">
                            <label class="form-label fw-bold small text-muted text-uppercase">Hoặc theo ngày</label>
                            <input type="date" name="searchDate" class="form-control border-0 shadow-sm"
                                   value="@(selectedDate?.ToString("yyyy-MM-dd"))">
                        </div>

                        <div class="col-md-4 col-sm-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm">
                                <i class="fas fa-search me-1"></i> Tìm kiếm
                            </button>
                            <a asp-action="Index" class="btn btn-light border shadow-sm" title="Xóa lọc">
                                <i class="fas fa-sync-alt"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="card-body p-0 mt-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase small fw-bold">
                        <tr>
                            <th class="ps-4 py-3">Lớp & Tuần</th>
                            <th>Thời gian</th>
                            <th>Năm học</th>
                            <th>Nhận xét GVCN</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                var editUrl = Url.Action("Edit", new { id = item.Id });
                                var detailUrl = Url.Action("Details", new { id = item.Id });

                                <tr class="hover-row border-bottom" onclick="navigateTo('@editUrl')">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="class-badge me-3">
                                                @item.Class
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">Tuần @item.WeekNumber</div>
                                                <div class="small text-muted">Mã sổ: #@item.Id</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark">
                                                @item.FromDate.ToString("dd/MM") - @item.ToDate.ToString("dd/MM")
                                            </span>
                                            <span class="small text-muted">@item.FromDate.Year</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge badge-soft badge-soft-primary">
                                            @item.SchoolYear
                                        </span>
                                    </td>

                                    <td style="max-width: 250px;">
                                        @if (!string.IsNullOrEmpty(item.HomeroomTeacherComment))
                                        {
                                            <span class="text-muted fst-italic text-truncate d-block"
                                                  title="@item.HomeroomTeacherComment">
                                                "@item.HomeroomTeacherComment"
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">- Chưa có nhận xét -</span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2" onclick="event.stopPropagation()">
                                            <a href="@editUrl" class="btn btn-sm btn-light text-primary"
                                               data-bs-toggle="tooltip" title="Chỉnh sửa">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-light text-danger"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                    onclick="setDeleteInfo('@item.Id', 'Sổ bài Lớp @item.Class - Tuần @item.WeekNumber')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                                        <p class="mb-1">Chưa có dữ liệu sổ đầu bài nào.</p>
                                        <a asp-action="Create" class="btn btn-link text-decoration-none">Tạo sổ mới ngay</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white py-3 border-top-0">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="text-muted small">
                    Hiển thị <strong>@Model.Items.Count</strong> / <strong>@Model.TotalRecords</strong> bản ghi
                </div>

                <partial name="_Pagination" model="Model" />
            </div>
        </div>
    </div>
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script>
        // Kích hoạt Tooltip của Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
          return new bootstrap.Tooltip(tooltipTriggerEl)
        })

        function navigateTo(url) {
            if(url) window.location.href = url;
        }

        function setDeleteInfo(id, name) {
            var form = document.querySelector('#deleteModal form');
            if(form) {
                form.action = '/ClassLogbook/Delete/' + id;
                var nameEl = document.getElementById('deleteItemName');
                if(nameEl) nameEl.innerText = name;
            }
        }
    </script>
}